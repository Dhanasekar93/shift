# Dockerfile.dev — M1 Mac (ARM64) + Intel (AMD64) compatible
# Runs under linux/amd64 emulation on M1 for full compatibility with
# Ruby 2.7 native gems, Go build, and MySQL client libraries.

# Stage 1: Build the Go runner
FROM --platform=linux/amd64 golang:1.22-bookworm AS builder

COPY runner /go/src/github.com/square/shift/runner
WORKDIR /go/src/github.com/square/shift/runner

ENV GO111MODULE=off
ENV GOPATH=/go:/go/src/github.com/square/shift/runner/Godeps/_workspace

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -a -installsuffix cgo -o /go/bin/shift-runner .

# Stage 2: Runtime
FROM --platform=linux/amd64 ruby:2.7-slim-bullseye

ENV DEBIAN_FRONTEND=noninteractive
ENV MYSQL_PWD=root

# System dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cpanminus \
    curl \
    default-libmysqlclient-dev \
    libdbd-mysql-perl \
    libdbi-perl \
    libgmp-dev \
    libio-socket-ssl-perl \
    libterm-readkey-perl \
    libyaml-perl \
    nginx \
    net-tools \
    apache2-utils \
    patch \
    perl \
    supervisor \
    wget \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Install YAML::Syck (required by patched pt-osc)
RUN cpanm YAML::Syck

# Install pt-online-schema-change v3.0.13 directly from GitHub + apply Shift patch
COPY ptosc-patch /opt/code/ptosc-patch
RUN curl -sL "https://raw.githubusercontent.com/percona/percona-toolkit/3.0.13/bin/pt-online-schema-change" \
        -o /usr/local/bin/pt-online-schema-change \
    && chmod +x /usr/local/bin/pt-online-schema-change \
    && patch /usr/local/bin/pt-online-schema-change /opt/code/ptosc-patch/0001-ptosc-square-changes.patch

# Install Ruby gems
COPY ui/Gemfile ui/Gemfile.lock /opt/code/ui/
WORKDIR /opt/code/ui
RUN bundle install --jobs 4 || bundle install --jobs 1

# Copy application code
COPY ui /opt/code/ui
COPY --from=builder /go/bin/shift-runner /opt/code/runner/runner

# Create directories
RUN mkdir -p /tmp/shift /var/run/mysqld /var/lib/mysql

# Copy entrypoint
COPY docker-entrypoint.sh /opt/code/
RUN chmod +x /opt/code/docker-entrypoint.sh

WORKDIR /opt/code
EXPOSE 3000 80

ENV RAILS_ENV=production
ENTRYPOINT ["/opt/code/docker-entrypoint.sh"]
CMD ["supervisord", "-n"]
